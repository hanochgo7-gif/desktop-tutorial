RewriteEngine On
# old site, English pages (?lang=en)
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^about/?$ /about.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^management/?$ /about.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^recommendations/?$ /projects.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^projects/?$ /projects.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^solutions/?$ /net-houses.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^agricultural\-shading\-solutions/?$ /net-houses.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^planning\-guiding/?$ /net-houses.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^civil\-shading\-solutions/?$ /? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^contact/?$ /contact.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^(project|project-category)/ /projects.html? [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^$ /? [R=301,L]
# old site, Hebrew pages
RewriteRule ^אודות/?$ /he/about.html [R=301,L,NC]
RewriteRule ^הנהלה/?$ /he/about.html [R=301,L,NC]
RewriteRule ^המלצות/?$ /he/projects.html [R=301,L,NC]
RewriteRule ^פרוייקטים/?$ /he/projects.html [R=301,L,NC]
RewriteRule ^project/?$ /he/projects.html [R=301,L,NC]
RewriteRule ^פתרונות/?$ /he/net-houses.html [R=301,L,NC]
RewriteRule ^פתרונות\-קירוי\-והצללה\-חקלאיים/?$ /he/net-houses.html [R=301,L,NC]
RewriteRule ^ייעוץ\-תכנון\-ניהול\-והדרכה/?$ /he/net-houses.html [R=301,L,NC]
RewriteRule ^פתרונות\-קירוי\-והצללה\-אזרחיים/?$ /he/ [R=301,L,NC]
RewriteRule ^יצירת\-קשר/?$ /he/contact.html [R=301,L,NC]
RewriteRule ^sample\-page/?$ /he/ [R=301,L,NC]
RewriteRule ^8/?$ /he/ [R=301,L,NC]
RewriteRule ^project/סככות\-העמסה/ /he/net-houses.html [R=301,L,NC]
RewriteRule ^project/בתי\-רשת\-לבננות/ /he/net-houses.html [R=301,L,NC]
RewriteRule ^project/ /he/projects.html [R=301,L,NC]
RewriteRule ^project\-category/ /he/projects.html [R=301,L,NC]
RewriteRule ^dt_testimonials/ /he/projects.html [R=301,L,NC]
RewriteRule ^ללא\-קטגוריה/ /he/ [R=301,L,NC]
RewriteRule ^category/ /he/ [R=301,L,NC]
RewriteRule ^(feed|comments/feed|xmlrpc\.php|wp-.*)(/.*)?$ - [G,L]
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/he/#">
  ErrorDocument 404 /he/404.html
</If>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml application/manifest+json text/plain
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
</IfModule>
# Turn on once HTTPS works on www.miftah.co.il (release checklist). HSTS only after the redirect is confirmed.
