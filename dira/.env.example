# Dira Ready — configuration. Copy to .env.local for development.
# With nothing set, the full Studio (on-device photo correction, removal, export) works.
# Accounts, AI tools and payments switch on only when their credentials below are present.
# In development (`npm run dev`) local stand-ins replace them: dev sign-in, mock AI, mock checkout.

# Public address of the site (payment returns, webhooks, sitemap).
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# WhatsApp in international format without + (shown for contact and manual purchases).
NEXT_PUBLIC_WHATSAPP=972553340694

# --- Accounts and storage: Supabase (Project Settings → API). Run supabase/schema.sql first.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI tools: Replicate (replicate.com/account/api-tokens). Secret.
REPLICATE_API_TOKEN=
# Optional: the webhook signing secret (whsec_…). Fetched automatically when empty.
REPLICATE_WEBHOOK_SECRET=

# --- Payments: Grow / Meshulam. Sandbox base by default; set the production base when going live.
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
GROW_API_BASE=https://sandbox.meshulam.co.il/api/light/server/1.0

# --- Daily cleanup of AI files older than 30 days (Vercel Cron sends this as a Bearer token).
CRON_SECRET=

# --- Testing only. Never set on the live site (ignored on Vercel production anyway).
# UNSAFE_DEV_MODES=1
# LOCAL_AUTH_SECRET=
# RATE_LIMIT_MULTIPLIER=
