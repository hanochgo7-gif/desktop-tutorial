# Cloudflare Pages: cache headers.
# The live site currently sends "Cache-Control: no-store" on every file,
# so returning visitors re-download everything. These rules fix that.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Images and fonts rarely change: cache for a week, refresh in the background
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
