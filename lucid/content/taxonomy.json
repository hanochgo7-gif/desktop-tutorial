  "error_types": [
    { "id": "copula-omission", "name_en": "Missing am/is/are", "name_he": "חסר am/is/are", "why_he": "בעברית אין פועל 'להיות' בהווה ('היא מורה'), ובאנגלית חייבים: She is a teacher." },
    { "id": "article", "name_en": "Article (a / an / the)", "name_he": "a / an / the", "why_he": "בעברית אין מילה ל-a/an, ולכן קל לשכוח אותה: I have a car." },
    { "id": "third-person-s", "name_en": "Third-person -s", "name_he": "ה-s של he/she/it", "why_he": "בהווה פשוט מוסיפים s אחרי he, she, it: She works." },
    { "id": "do-support", "name_en": "Questions/negatives with do/does/did", "name_he": "שאלה ושלילה עם do/does/did", "why_he": "בעברית שאלה נבנית באינטונציה בלבד; באנגלית צריך do/does/did: Do you like it?" },
    { "id": "word-order", "name_en": "Word order", "name_he": "סדר מילים", "why_he": "באנגלית התואר לפני שם העצם (a big house) ולסדר המילים יש משמעות דקדוקית." },
    { "id": "tense-choice", "name_en": "Choice of tense", "name_he": "בחירת זמן", "why_he": "באנגלית יש יותר זמנים מבעברית (למשל present perfect), וכל אחד מבטא משמעות אחרת." },
    { "id": "verb-form", "name_en": "Verb form (irregular, participle, -ing)", "name_he": "צורת הפועל", "why_he": "פעלים חריגים צריך לזכור: go – went – gone." },
    { "id": "agreement", "name_en": "Subject-verb agreement", "name_he": "התאמה בין נושא לפועל", "why_he": "הפועל מתאים לנושא: The people are, not The people is." },
    { "id": "plural-form", "name_en": "Plural form", "name_he": "צורת רבים", "why_he": "יש רבים חריגים: child – children, person – people." },
    { "id": "countability", "name_en": "Countable / uncountable", "name_he": "ספיר / לא ספיר", "why_he": "מילים כמו information ו-advice אינן ספירות באנגלית (אין informations)." },
    { "id": "preposition", "name_en": "Preposition", "name_he": "מילת יחס", "why_he": "מילות היחס לא מתורגמות אחד לאחד: 'תלוי ב' = depends on, לא depends in." },
    { "id": "pronoun", "name_en": "Pronoun", "name_he": "כינוי גוף", "why_he": "באנגלית אין השמטת נושא: It is raining, לא Is raining." },
    { "id": "spelling", "name_en": "Spelling", "name_he": "איות", "why_he": "האיות באנגלית לא תמיד תואם את ההגייה, ולכן כדאי לתרגל מילים נפוצות." },
    { "id": "capitalization", "name_en": "Capital letters", "name_he": "אותיות גדולות", "why_he": "בעברית אין אותיות גדולות; באנגלית: תחילת משפט, I, שמות, ימים וחודשים." },
    { "id": "punctuation", "name_en": "Punctuation and run-on sentences", "name_he": "פיסוק ומשפטים רצים", "why_he": "באנגלית לא מחברים שני משפטים שלמים בפסיק בלבד; משתמשים בנקודה או במילת קישור." },
    { "id": "word-choice", "name_en": "Word choice / collocation", "name_he": "בחירת מילה / צירוף", "why_he": "יש צירופים קבועים: make a decision, do homework, strong coffee." },
    { "id": "false-friend", "name_en": "False friend / literal translation", "name_he": "תרגום מילולי", "why_he": "תרגום מילה במילה מעברית יוצר לפעמים משפט לא טבעי: 'I am 20 years' במקום I am 20 (years old)." },
    { "id": "register", "name_en": "Register (too formal / too informal)", "name_he": "משלב", "why_he": "באנגלית מקפידים על משלב לפי ההקשר: אין קיצורים וסלנג בחיבור אקדמי." },
    { "id": "modal-use", "name_en": "Modal verbs", "name_he": "פעלים מודאליים", "why_he": "אחרי can, must, should בא פועל בסיס בלי to: You should go." },
    { "id": "conditional-form", "name_en": "Conditional form", "name_he": "מבנה משפט תנאי", "why_he": "לא משתמשים ב-will אחרי if בתנאי ראשון: If it rains, we will stay." },
    { "id": "passive-form", "name_en": "Passive form", "name_he": "מבנה סביל", "why_he": "סביל = be + past participle: The car was repaired." },
    { "id": "reported-speech", "name_en": "Reported speech", "name_he": "דיבור עקיף", "why_he": "בדיבור עקיף הזמן לרוב 'זז אחורה': She said she was tired." },
    { "id": "gerund-infinitive", "name_en": "Gerund or infinitive", "name_he": "שם פעולה או מקור", "why_he": "חלק מהפעלים מקבלים -ing (enjoy doing) וחלק to (want to do)." },
    { "id": "relative-clause", "name_en": "Relative clause", "name_he": "משפט זיקה", "why_he": "באנגלית לא חוזרים על הכינוי: the book that I read, לא the book that I read it." },
