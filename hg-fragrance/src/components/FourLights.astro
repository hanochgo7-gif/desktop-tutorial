---
/**
 * "One flacon, four lights" — the collection as one anchored bottle.
 * The stage stays pinned (CSS sticky) while the four season blocks scroll past it;
 * whichever block is in the middle of the viewport re-lights the bottle: juice colour
 * (the four real packshots share one framing), the light behind it and the season word.
 * No scroll hijacking: the copy is ordinary content in the document flow.
 * Without JS the first season shows; under reduced motion the changes are instant.
 */
import Media from './Media.astro';
import { bySeason, fromPrice } from '../data/catalog';
import { commerce } from '../config/site';

const items = bySeason();
const fmt = new Intl.NumberFormat('en', { style: 'currency', currency: commerce.currency, maximumFractionDigits: 0 });
---

<section class="fl" aria-labelledby="fl-title" data-fl>
  <header class="fl__head wrap grid">
    <p class="label faint" data-reveal="fade">The collection</p>
    <h2 class="h1" id="fl-title" data-reveal="lines">One flacon, <em>four lights</em></h2>
    <p class="lead muted fl__intro" data-reveal="fade">
      The same bottle through the year. The window opened in spring, the last light of summer, the lamp left on in
      autumn, the fire in winter — only the light inside it changes.
    </p>
  </header>

  <div class="fl__seq">
    <div class="fl__stage" data-fl-stage aria-hidden="true" style={`--fl-accent:${items[0].accent}`}>
      <div class="fl__light"></div>
      <div class="fl__words">
        {items.map((p, i) => <p class:list={['fl__word', { 'is-active': i === 0 }]} data-fl-word>{p.season}</p>)}
      </div>
      <div class="fl__bottle">
        {
          items.map((p, i) => (
            <div class:list={['fl__frame', { 'is-active': i === 0 }]} data-fl-frame>
              <Media name={p.packshot} alt="" ratio="4 / 5" sizes="(min-width: 900px) 34vw, 62vw" reveal={false} />
            </div>
          ))
        }
      </div>
      <ol class="fl__ticks" role="list">
        {
          items.map((p, i) => (
            <li class:list={['fl__tick', { 'is-active': i === 0 }]} data-fl-tick style={`--accent:${p.accent}`}>
              <span class="fl__tick-dot" />
              <span class="label">{p.season}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="fl__steps">
      {
        items.map((p, i) => {
          const price = fromPrice(p);
          return (
            <article class="fl__step" data-fl-step data-accent={p.accent} style={`--accent:${p.accent}`} aria-labelledby={`fl-${p.slug}`}>
              <div class="wrap grid">
                <div class="fl__copy">
                  <p class="label fl__season">
                    <span class="fl__dot" aria-hidden="true" />
                    {p.season} <span class="faint">· {p.number} · {String(i + 1).padStart(2, '0')} / 04</span>
                  </p>
                  <h3 class="fl__name" id={`fl-${p.slug}`}>{p.name}</h3>
                  <p class="lead it muted">{p.shortLine}</p>
                  <p class="fl__meta">
                    <span class="label faint">{p.concentration}</span>
                    {p.notes && <span class="serif">{[p.notes.top[0], p.notes.heart[0], p.notes.base[0]].join(' · ')}</span>}
                  </p>
                  <p class="label fl__status">
                    {p.status === 'available' && price !== null ? (
                      <>
                        From {fmt.format(price)}
                      </>
                    ) : (
                      <span class="faint">Coming soon</span>
                    )}
                  </p>
                  <a class:list={['btn', { 'btn--solid': p.status === 'available' }]} href={`/fragrances/${p.slug}`}>
                    Discover {p.name}<span class="arrow" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

</section>

<style is:global>
  @property --fl-accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #c8a66b;
  }
  .fl {
    padding-top: var(--section);
    position: relative;
  }
  .fl__head {
    row-gap: 1.5rem;
    margin-bottom: clamp(1rem, 4vw, 3rem);
  }
  .fl__head > * {
    grid-column: 1 / -1;
  }
  .fl__intro {
    max-width: 36rem;
  }
  .fl__seq {
    position: relative;
    padding-bottom: var(--section);
  }

  /* ---- the pinned stage ---- */
  .fl__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    transition: --fl-accent 1.1s var(--ease-soft);
  }
  .fl__light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38% 46% at var(--fl-x, 50%) 50%, color-mix(in oklab, var(--fl-accent) 30%, transparent), transparent 72%),
      radial-gradient(80% 60% at var(--fl-x, 50%) 110%, color-mix(in oklab, var(--fl-accent) 12%, transparent), transparent 70%);
  }
  .fl__words {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: start center;
    padding-top: calc(var(--header-h) + 18svh);
    pointer-events: none;
  }
  .fl__word {
    grid-area: 1 / 1;
    font-family: var(--f-serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(6rem, 3rem + 19vw, 24rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in oklab, var(--fl-accent) 16%, transparent);
    opacity: 0;
    transform: translateY(0.08em);
    transition:
      opacity 0.9s var(--ease-out),
      transform 1.2s var(--ease-out);
  }
  .fl__word.is-active {
    opacity: 1;
    transform: none;
  }
  .fl__bottle {
    position: absolute;
    left: 50%;
    top: calc(var(--header-h) + 2svh);
    width: min(64vw, 40svh);
    aspect-ratio: 4 / 5;
    translate: -50% 0;
  }
  .fl__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease-soft);
  }
  .fl__frame.is-active {
    opacity: 1;
  }
  .fl__frame .media {
    height: 100%;
    background: transparent;
    /* melt the studio backdrop into the coloured light so only the flacon reads */
    -webkit-mask-image: radial-gradient(48% 54% at 50% 52%, #000 38%, rgb(0 0 0 / 0.55) 66%, transparent 100%);
    mask-image: radial-gradient(48% 54% at 50% 52%, #000 38%, rgb(0 0 0 / 0.55) 66%, transparent 100%);
  }
  .fl__frame img {
    filter: brightness(0.94) contrast(1.06);
  }
  .fl__ticks {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(var(--header-h) + 0.5rem);
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }
  @media (max-width: 420px) {
    .fl__ticks {
      gap: 0.75rem;
    }
    .fl__tick .label {
      letter-spacing: 0.12em;
    }
  }
  .fl__tick {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-faint);
    transition: color var(--dur-3);
  }
  .fl__tick-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
    transition: background-color var(--dur-3);
  }
  .fl__tick.is-active {
    color: var(--c-text);
  }
  .fl__tick.is-active .fl__tick-dot {
    background: var(--accent);
  }

  /* ---- the scrolling copy ---- */
  .fl__steps {
    position: relative;
    margin-top: -100svh;
  }
  .fl__step {
    min-height: 100svh;
    display: grid;
    align-items: end;
  }
  .fl__copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 5rem 0 clamp(2rem, 6svh, 3.5rem);
    background: linear-gradient(to top, var(--c-ink) 62%, transparent);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .fl__season {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .fl__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .fl__name {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: var(--step-3);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .fl__meta {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--c-line);
    width: 100%;
    max-width: 26rem;
  }
  .fl__meta .serif {
    font-size: var(--step-1);
  }

  @media (min-width: 900px) {
    .fl__head > p.label {
      grid-column: 1 / span 3;
      padding-top: 1.2rem;
    }
    .fl__head > h2,
    .fl__head > .fl__intro {
      grid-column: 4 / -1;
    }
    .fl__stage {
      --fl-x: 34%;
    }
    .fl__words {
      place-items: center start;
      padding: 0 0 0 6vw;
    }
    .fl__bottle {
      left: 34%;
      top: 50%;
      width: min(34vw, 64svh);
      translate: -50% -46%;
    }
    .fl__ticks {
      top: auto;
      bottom: 2.5rem;
      justify-content: flex-start;
      gap: 2rem;
    }
    .fl__step {
      align-items: center;
    }
    .fl__copy {
      grid-column: 8 / span 5;
      background: none;
      margin: 0;
      padding: 0;
      gap: 1.1rem;
    }
    .fl__name {
      font-size: clamp(3rem, 1.2rem + 4vw, 6rem);
    }
  }
  /* very short landscape phones: keep the bottle out of the copy */
  @media (max-width: 899px) and (max-height: 560px) {
    .fl__bottle {
      width: 28svh;
    }
  }
</style>
