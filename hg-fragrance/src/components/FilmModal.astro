---
import FilmPlayer from './FilmPlayer.astro';
import { t } from '../i18n/ui';
import { site } from '../config/site';
const lang = site.locale.lang;
---

<div class="film-modal" role="dialog" aria-modal="true" aria-label="HG — Unforgettable, the film" data-film-modal inert>
  <button class="close-btn label film-modal__close" type="button" data-film-close>
    <span class="close-btn__x" aria-hidden="true"></span>
    {t('film.close', lang)}
  </button>
  <div class="film-modal__frame">
    <FilmPlayer id="film-modal-video" />
  </div>
</div>
