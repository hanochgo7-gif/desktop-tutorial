---
/**
 * The four-season collection as a row of product cards (spring → winter).
 * Desktop: four columns. Mobile: a snap carousel.
 */
import Media from './Media.astro';
import { bySeason, fromPrice } from '../data/catalog';
import { commerce } from '../config/site';

interface Props {
  current?: string; // slug of the product being viewed (marked, not linked)
  headingLevel?: 'h2' | 'h3';
}
const { current, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const fmt = new Intl.NumberFormat('en', { style: 'currency', currency: commerce.currency, maximumFractionDigits: 0 });
const items = bySeason();
---

<ol class="seasons" role="list">
  {
    items.map((p) => {
      const price = fromPrice(p);
      const isCurrent = p.slug === current;
      return (
        <li class:list={['season-card', { 'is-current': isCurrent }]} style={`--accent:${p.accent}`}>
          <a class="season-card__link" href={`/fragrances/${p.slug}`} aria-current={isCurrent ? 'page' : undefined} data-cursor="Discover">
            <Media name={p.packshot} alt={`${p.name} — the HG bottle`} ratio="4 / 5" sizes="(min-width: 1000px) 23vw, 70vw" />
            <span class="season-card__meta">
              <span class="label season-card__season">
                <span class="season-card__dot" aria-hidden="true" />
                {p.season}
                <span class="faint">· {p.number}</span>
              </span>
              <H class="season-card__name serif">{p.name}</H>
              <span class="season-card__line it muted serif">{p.shortLine}</span>
              <span class="season-card__price label">
                {p.status === 'available' && price !== null ? (
                  <>From {fmt.format(price)}</>
                ) : (
                  <span class="faint">Coming soon</span>
                )}
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ol>

<style is:global>
  .seasons {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 70vw;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    contain: paint;
  }
  .seasons::-webkit-scrollbar {
    display: none;
  }
  .season-card {
    scroll-snap-align: start;
  }
  .season-card__link {
    display: grid;
    gap: 1.1rem;
  }
  .season-card .media {
    background: #2b2420;
  }
  .season-card .media img {
    transition: transform 1.4s var(--ease-out);
  }
  .season-card__link:hover .media img {
    transform: scale(1.04);
  }
  .season-card__meta {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--c-line);
    position: relative;
  }
  .season-card__meta::before {
    content: '';
    position: absolute;
    top: -1px;
    inset-inline-start: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0.18);
    transform-origin: 0 50%;
    transition: transform var(--dur-3) var(--ease-out);
  }
  [dir='rtl'] .season-card__meta::before {
    transform-origin: 100% 50%;
  }
  .season-card__link:hover .season-card__meta::before,
  .season-card.is-current .season-card__meta::before {
    transform: scaleX(1);
  }
  .season-card__season {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .season-card__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .season-card__name {
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.05;
  }
  .season-card__line {
    font-size: var(--step-0);
  }
  .season-card__price {
    margin-top: 0.35rem;
  }
  .season-card.is-current .season-card__name::after {
    content: ' — viewing';
    font-size: var(--step--1);
    font-family: var(--f-sans);
    color: var(--c-faint);
    letter-spacing: 0;
  }
  @media (min-width: 1000px) {
    .seasons {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      margin: 0;
      padding: 0;
      contain: none;
    }
    .season-card:nth-child(even) {
      margin-top: 4rem;
    }
  }
</style>
