---
/** Full-screen image viewer (native <dialog>). Opened by any [data-lightbox] button on the page. */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Campaign image">
  <div class="lightbox__bar">
    <p class="label faint" data-lightbox-caption></p>
    <button class="close-btn label" type="button" data-lightbox-close>
      <span class="close-btn__x" aria-hidden="true"></span> Close
    </button>
  </div>
  <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" class="lightbox__img" />
  <div class="lightbox__nav">
    <button class="btn" type="button" data-lightbox-prev>Previous</button>
    <button class="btn" type="button" data-lightbox-next>Next</button>
  </div>
</dialog>

<style is:global>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    background: rgb(6 5 5 / 0.97);
    color: var(--c-ivory);
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
  }
  .lightbox[open] {
    display: grid;
    animation: lb-in 500ms var(--ease-out);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .lightbox__nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
