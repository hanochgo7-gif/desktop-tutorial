---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';

const principles = [
  {
    title: 'Night as material',
    text: 'HG is seen after dark: rain on glass, a single lamp, the city held at a distance. Darkness is not a mood here; it is the canvas everything else is drawn on.',
  },
  {
    title: 'Amber, glass, brass',
    text: 'One palette, kept strictly. Amber juice, clear faceted glass, a thin line of brass, matte black. Nothing is added for decoration.',
  },
  {
    title: 'The room after',
    text: 'Our story is not the moment a fragrance is worn but the moment after it: the empty chair, the lamp still on, the air not quite returned to itself.',
  },
  {
    title: 'Few words',
    text: 'We say less and mean it. No borrowed legends and no invented history — only what we can show you.',
  },
];
---

<Base title="The House" description="The HG world: night as material, amber, glass and brass, and the room after you have gone.">
  <section class="house-hero" aria-labelledby="house-title">
    <div class="wrap grid house-hero__grid">
      <p class="label faint house-hero__label" data-reveal="fade" data-immediate>The House</p>
      <h1 class="display house-hero__title" id="house-title" data-reveal="lines" data-immediate data-delay="0.1">
        A house <em>of few words.</em>
      </h1>
    </div>
    <div class="house-hero__media wrap">
      <Media name="film-window" alt="A man at a tall rain-streaked window, the city lit below; the HG bottle on the desk" ratio="21 / 9" sizes="100vw" priority parallax={8} />
    </div>
    <div class="wrap grid house-hero__intro">
      <p class="lead" data-reveal="fade">
        HG began with a single fragrance and a single film; the seasons followed in the same bottle. Everything you see here comes from that first night, and one idea —
        <em class="brass">that presence is measured by what remains.</em>
      </p>
    </div>
  </section>

  <section class="section theme-ivory house-principles" aria-labelledby="principles-title">
    <div class="wrap">
      <header class="house-principles__head grid">
        <p class="label faint" data-reveal="fade">Four principles</p>
        <h2 class="h1" id="principles-title" data-reveal="lines">What HG <em>is made of</em></h2>
      </header>
      <ol class="house-principles__list" role="list">
        {
          principles.map((p, i) => (
            <li class="house-principle grid">
              <span class="num house-principle__n" data-reveal="fade">0{i + 1}</span>
              <h3 class="h2 house-principle__t" data-reveal="lines">{p.title}</h3>
              <p class="house-principle__p muted" data-reveal="fade">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section house-pair" aria-label="Details">
    <div class="wrap grid">
      <figure class="house-pair__a">
        <Media name="film-exit" alt="Still from the film: he leaves through a lit doorway while the desk lamp stays on" ratio="2 / 3" sizes="(min-width: 900px) 30vw, 80vw" position="48% 50%" parallax={6} />
        <figcaption class="media-cap label"><span>The door</span><span>The lamp left on</span></figcaption>
      </figure>
      <div class="house-pair__copy">
        <p class="h3" data-reveal="lines">Everything is chosen for the moment someone walks back in — <em>and notices.</em></p>
        <a class="btn btn--solid" href="/fragrances/unforgettable" data-reveal="fade" data-magnetic>Discover Unforgettable<span class="arrow" aria-hidden="true"></span></a>
      </div>
      <figure class="house-pair__b" data-speed="0.14">
        <Media name="still-amber" alt="Amber light refracted through bevelled glass onto black stone" ratio="4 / 3" sizes="(min-width: 900px) 34vw, 90vw" />
      </figure>
    </div>
  </section>
</Base>

<style is:global>
  .house-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
  }
  .house-hero__grid {
    row-gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .house-hero__label,
  .house-hero__title {
    grid-column: 1 / -1;
  }
  .house-hero__title {
    font-size: clamp(3.4rem, 1rem + 10vw, 14rem);
  }
  .house-hero__media .media {
    max-height: 78svh;
  }
  .house-hero__intro {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .house-hero__intro .lead {
    grid-column: 1 / -1;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.6rem);
    line-height: 1.25;
  }
  @media (min-width: 900px) {
    .house-hero__label {
      grid-column: 1 / span 3;
      padding-top: 2rem;
    }
    .house-hero__title {
      grid-column: 4 / -1;
    }
    .house-hero__intro .lead {
      grid-column: 4 / span 8;
    }
  }

  .house-principles__head {
    row-gap: 1rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .house-principles__head > * {
    grid-column: 1 / -1;
  }
  .house-principle {
    row-gap: 1rem;
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--c-line);
    align-items: baseline;
  }
  .house-principle:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .house-principle__n {
    grid-column: 1 / span 2;
    font-size: var(--step-1);
  }
  .house-principle__t {
    grid-column: 3 / -1;
  }
  .house-principle__p {
    grid-column: 3 / -1;
    max-width: 32rem;
  }
  @media (min-width: 900px) {
    .house-principles__head > p {
      grid-column: 1 / span 3;
      padding-top: 1.4rem;
    }
    .house-principles__head > h2 {
      grid-column: 4 / -1;
    }
    .house-principle__n {
      grid-column: 1 / span 3;
    }
    .house-principle__t {
      grid-column: 4 / span 4;
    }
    .house-principle__p {
      grid-column: 9 / span 4;
    }
  }

  .house-pair .grid {
    row-gap: 3rem;
    align-items: start;
  }
  .house-pair__a {
    grid-column: 1 / span 9;
  }
  .house-pair__copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .house-pair__b {
    grid-column: 4 / -1;
  }
  @media (min-width: 900px) {
    .house-pair__a {
      grid-column: 1 / span 4;
    }
    .house-pair__copy {
      grid-column: 6 / span 6;
      margin-top: 8rem;
    }
    .house-pair__b {
      grid-column: 7 / span 6;
      margin-top: -4rem;
    }
  }
</style>
