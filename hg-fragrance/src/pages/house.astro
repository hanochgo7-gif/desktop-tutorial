---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Lightbox from '../components/Lightbox.astro';
import { getImage } from 'astro:assets';
import { img } from '../assets/images';
import { site } from '../config/site';

/** The HG casting: the faces every campaign is built from (AI-generated). */
const faces = [
  { name: 'face-m1', alt: 'Casting portrait: a man with dark swept hair and light eyes, black shirt open at the collar' },
  { name: 'face-w1', alt: 'Casting portrait: a woman with long brown hair in a structured grey-and-brass jacket' },
  { name: 'face-m2', alt: 'Casting portrait: a man with dark wavy hair and a beard, black shirt open at the collar' },
  { name: 'face-w2', alt: 'Casting portrait: a woman with long dark hair in a black tailored blazer dress' },
  { name: 'face-m3', alt: 'Casting portrait: a man with slicked-back dark hair and stubble, black shirt unbuttoned' },
  { name: 'face-w3', alt: 'Casting portrait: a woman with long wavy brown hair in black with a bronze bodice' },
  { name: 'face-m4', alt: 'Casting portrait: a man with a trimmed beard in a black shirt, hands in his pockets' },
  { name: 'face-w4', alt: 'Casting portrait: a woman with long waves in a draped black-and-gold dress' },
];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const facesFull = await Promise.all(faces.map((f) => getImage({ src: img(f.name), width: 1400, format: 'webp', quality: 82 })));

const principles = [
  {
    title: 'Night as material',
    text: 'HG is seen after dark: rain on glass, a single lamp, the city held at a distance. Darkness is not a mood here; it is the canvas everything else is drawn on.',
  },
  {
    title: 'Amber, glass, brass',
    text: 'One palette, kept strictly. Amber juice, clear faceted glass, a thin line of brass, matte black. Nothing is added for decoration.',
  },
  {
    title: 'The room after',
    text: 'Our story is not the moment a fragrance is worn but the moment after it: the empty chair, the lamp still on, the air not quite returned to itself.',
  },
  {
    title: 'Few words',
    text: 'We say less and mean it. No borrowed legends and no invented history — only what we can show you.',
  },
];
---

<Base title="The House" description="The HG world: night as material, amber, glass and brass, and the room after you have gone.">
  <section class="house-hero" aria-labelledby="house-title">
    <div class="wrap grid house-hero__grid">
      <p class="label faint house-hero__label" data-reveal="fade" data-immediate>The House</p>
      <h1 class="display house-hero__title" id="house-title" data-reveal="lines" data-immediate data-delay="0.1">
        A house <em>of few words.</em>
      </h1>
    </div>
    <div class="house-hero__media wrap">
      <Media name="film-window" alt="A man at a tall rain-streaked window, the city lit below; the HG bottle on the desk" ratio="21 / 9" sizes="100vw" priority parallax={8} />
    </div>
    <div class="wrap grid house-hero__intro">
      <p class="lead" data-reveal="fade">
        HG began with a single fragrance and a single film; the seasons followed in the same bottle. Everything you see here comes from that first night, and one idea —
        <em class="brass">that presence is measured by what remains.</em>
      </p>
    </div>
  </section>

  <section class="section theme-ivory house-principles" aria-labelledby="principles-title">
    <div class="wrap">
      <header class="house-principles__head grid">
        <p class="label faint" data-reveal="fade">Four principles</p>
        <h2 class="h1" id="principles-title" data-reveal="lines">What HG <em>is made of</em></h2>
      </header>
      <ol class="house-principles__list" role="list">
        {
          principles.map((p, i) => (
            <li class="house-principle grid">
              <span class="num house-principle__n" data-reveal="fade">0{i + 1}</span>
              <h3 class="h2 house-principle__t" data-reveal="lines">{p.title}</h3>
              <p class="house-principle__p muted" data-reveal="fade">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section house-faces" id="faces" aria-labelledby="faces-title">
    <div class="wrap">
      <header class="house-faces__head grid">
        <p class="label faint" data-reveal="fade">The faces</p>
        <h2 class="h1" id="faces-title" data-reveal="lines">Eight faces, <em>one night</em></h2>
        <p class="muted house-faces__intro" data-reveal="fade">
          The casting every HG campaign is built from — four men and four women, seen as themselves before the lights go
          down. {site.aiDisclosure.replace('Campaign film and imagery', 'Like the campaigns, they are')}
        </p>
      </header>
      <ol class="house-faces__grid" role="list">
        {
          faces.map((f, i) => (
            <li class="house-faces__item">
              <button
                type="button"
                class="house-faces__btn"
                data-lightbox="faces"
                data-full={facesFull[i].src}
                data-alt={f.alt}
                data-caption={`Face ${roman[i]}`}
                data-cursor="View"
                aria-label={`Open face ${roman[i]}: ${f.alt}`}
              >
                <Media name={f.name} alt={f.alt} ratio="3 / 4" position="50% 18%" sizes="(min-width: 900px) 23vw, 46vw" />
              </button>
              <p class="media-cap label"><span class="num">{roman[i]}</span><span>Face</span></p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section house-pair" aria-label="Details">
    <div class="wrap grid">
      <figure class="house-pair__a">
        <Media name="film-exit" alt="Still from the film: he leaves through a lit doorway while the desk lamp stays on" ratio="2 / 3" sizes="(min-width: 900px) 30vw, 80vw" position="48% 50%" parallax={6} />
        <figcaption class="media-cap label"><span>The door</span><span>The lamp left on</span></figcaption>
      </figure>
      <div class="house-pair__copy">
        <p class="h3" data-reveal="lines">Everything is chosen for the moment someone walks back in — <em>and notices.</em></p>
        <a class="btn btn--solid" href="/fragrances/unforgettable" data-reveal="fade" data-magnetic>Discover Unforgettable<span class="arrow" aria-hidden="true"></span></a>
      </div>
      <figure class="house-pair__b" data-speed="0.14">
        <Media name="still-amber" alt="Amber light refracted through bevelled glass onto black stone" ratio="4 / 3" sizes="(min-width: 900px) 34vw, 90vw" />
      </figure>
    </div>
  </section>

  <Lightbox />
</Base>

<style is:global>
  .house-faces__head {
    row-gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .house-faces__head > * {
    grid-column: 1 / -1;
  }
  .house-faces__intro {
    max-width: 34rem;
  }
  .house-faces__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) var(--gap);
  }
  .house-faces__item:nth-child(even) {
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .house-faces__btn {
    display: block;
    width: 100%;
  }
  /* a quiet casting grade that lifts to full colour on attention */
  .house-faces__btn img {
    filter: grayscale(0.55) contrast(1.06) brightness(0.9);
    transition:
      filter var(--dur-3) var(--ease-out),
      transform 1.4s var(--ease-out);
  }
  .house-faces__btn:hover img,
  .house-faces__btn:focus-visible img {
    filter: none;
    transform: scale(1.03);
  }
  @media (min-width: 900px) {
    .house-faces__head > p.label {
      grid-column: 1 / span 3;
      padding-top: 1.2rem;
    }
    .house-faces__head > h2,
    .house-faces__head > .house-faces__intro {
      grid-column: 4 / -1;
    }
    .house-faces__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: clamp(2rem, 4vw, 3.5rem);
    }
    .house-faces__item:nth-child(even) {
      margin-top: 0;
    }
    .house-faces__item:nth-child(4n + 2),
    .house-faces__item:nth-child(4n + 4) {
      margin-top: clamp(3rem, 6vw, 6rem);
    }
  }
  .house-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
  }
  .house-hero__grid {
    row-gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .house-hero__label,
  .house-hero__title {
    grid-column: 1 / -1;
  }
  .house-hero__title {
    font-size: clamp(3.4rem, 1rem + 10vw, 14rem);
  }
  .house-hero__media .media {
    max-height: 78svh;
  }
  .house-hero__intro {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .house-hero__intro .lead {
    grid-column: 1 / -1;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.6rem);
    line-height: 1.25;
  }
  @media (min-width: 900px) {
    .house-hero__label {
      grid-column: 1 / span 3;
      padding-top: 2rem;
    }
    .house-hero__title {
      grid-column: 4 / -1;
    }
    .house-hero__intro .lead {
      grid-column: 4 / span 8;
    }
  }

  .house-principles__head {
    row-gap: 1rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .house-principles__head > * {
    grid-column: 1 / -1;
  }
  .house-principle {
    row-gap: 1rem;
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--c-line);
    align-items: baseline;
  }
  .house-principle:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .house-principle__n {
    grid-column: 1 / span 2;
    font-size: var(--step-1);
  }
  .house-principle__t {
    grid-column: 3 / -1;
  }
  .house-principle__p {
    grid-column: 3 / -1;
    max-width: 32rem;
  }
  @media (min-width: 900px) {
    .house-principles__head > p {
      grid-column: 1 / span 3;
      padding-top: 1.4rem;
    }
    .house-principles__head > h2 {
      grid-column: 4 / -1;
    }
    .house-principle__n {
      grid-column: 1 / span 3;
    }
    .house-principle__t {
      grid-column: 4 / span 4;
    }
    .house-principle__p {
      grid-column: 9 / span 4;
    }
  }

  .house-pair .grid {
    row-gap: 3rem;
    align-items: start;
  }
  .house-pair__a {
    grid-column: 1 / span 9;
  }
  .house-pair__copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .house-pair__b {
    grid-column: 4 / -1;
  }
  @media (min-width: 900px) {
    .house-pair__a {
      grid-column: 1 / span 4;
    }
    .house-pair__copy {
      grid-column: 6 / span 6;
      margin-top: 8rem;
    }
    .house-pair__b {
      grid-column: 7 / span 6;
      margin-top: -4rem;
    }
  }
</style>
