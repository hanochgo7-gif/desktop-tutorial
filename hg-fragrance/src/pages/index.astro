---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Purchase from '../components/Purchase.astro';
import { getProduct } from '../data/catalog';
import { img } from '../assets/images';

const product = getProduct('unforgettable')!;

// Hero: one photograph, art-directed — the landscape frame on wide screens, the portrait frame on tall ones.
const wide = img('drv-sill');
const tall = img('drv-window');
const wideSet = await Promise.all([960, 1440, 1920, wide.width].map((w) => getImage({ src: wide, width: w, format: 'webp', quality: 80 })));
const tallSet = await Promise.all([640, 960, 1280, tall.width].map((w) => getImage({ src: tall, width: w, format: 'webp', quality: 78 })));
const wideJpg = await getImage({ src: wide, width: 1600, format: 'jpg', quality: 80 });
// Closing: the empty study on wide screens, the bottle alone under the lamp on tall ones.
const room = img('unf-empty-study');
const roomTall = img('unf-packshot-vertical');
const roomSet = await Promise.all([960, 1440, 1920, room.width].map((w) => getImage({ src: room, width: w, format: 'webp', quality: 78 })));
const roomTallSet = await Promise.all([640, 960, roomTall.width].map((w) => getImage({ src: roomTall, width: w, format: 'webp', quality: 78 })));
const roomJpg = await getImage({ src: room, width: 1600, format: 'jpg', quality: 78 });
const srcset = (set: { src: string; attributes: Record<string, unknown> }[]) =>
  set.map((s) => `${s.src} ${s.attributes.width}w`).join(', ');

const campaign = [
  { name: 'face-m1', alt: 'In a dark study by a rain-streaked window, a man in a black shirt holds Unforgettable at his chest', ratio: '3 / 4', cls: 'a' },
  { name: 'face-m4', alt: 'A man in a black silk shirt holds Unforgettable up to the light', ratio: '3 / 4', cls: 'b' },
  { name: 'riv-two', alt: 'On a candlelit terrace above the sea, a woman in crimson silk leans into him, eyes closed', ratio: '16 / 9', cls: 'c', position: '62% 40%' },
  { name: 'face-w3', alt: 'A woman in black satin rests the Unforgettable bottle against her cheek', ratio: '4 / 5', cls: 'd', position: '50% 30%' },
  { name: 'riv-dressing', alt: 'In a dim dressing room he holds Unforgettable, his reflection in the mirror behind', ratio: '4 / 5', cls: 'e', position: '58% 40%' },
] as const;
---

<Base description="HG Unforgettable, Eau de Parfum. Leave the room. Stay in it.">
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" media="(max-aspect-ratio: 4/5)" imagesrcset={srcset(tallSet)} imagesizes="max(100vw, 75vh)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" media="(min-aspect-ratio: 401/500)" imagesrcset={srcset(wideSet)} imagesizes="max(100vw, 178vh)" fetchpriority="high" />
  </Fragment>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero__media">
      <source media="(max-aspect-ratio: 4/5)" srcset={srcset(tallSet)} sizes="max(100vw, 75vh)" type="image/webp" />
      <source srcset={srcset(wideSet)} sizes="max(100vw, 178vh)" type="image/webp" />
      <img
        src={wideJpg.src}
        alt="Through the open window of a black car at night, a man looks into the camera, the Unforgettable bottle in his hand"
        width={wide.width}
        height={wide.height}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__content wrap">
      <p class="label hero__kicker">Unforgettable <span aria-hidden="true">·</span> Eau de Parfum</p>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__line"><span>Leave the room.</span></span>
        <span class="hero__line"><span><em>Stay in it.</em></span></span>
      </h1>
      <a class="btn btn--solid hero__cta" href="/fragrances/unforgettable">Discover Unforgettable</a>
    </div>
  </section>

  <!-- ============ THE FEELING ============ -->
  <section class="section feel" aria-labelledby="feel-title">
    <div class="wrap grid">
      <div class="feel__copy">
        <h2 class="h2 feel__title" id="feel-title" data-reveal="lines">Some presences end at the door. <em>Others stay.</em></h2>
        <p class="feel__text muted" data-reveal="fade">
          Unforgettable is made for the moment after he has gone — the lamp still on, the room still holding him.
        </p>
        <a class="link label" href="/film" data-open-film data-reveal="fade">Watch the film</a>
      </div>
      <div class="feel__visual">
        <Media name="unf-door" alt="He leaves the study through a lit doorway; the lamp stays on and the bottle stays on the desk" ratio="3 / 2" sizes="(min-width: 900px) 58vw, 100vw" position="62% 50%" />
      </div>
    </div>
  </section>

  <!-- ============ THE CAMPAIGN ============ -->
  <section class="section camp" aria-labelledby="camp-title">
    <div class="wrap">
      <header class="camp__head">
        <h2 class="label" id="camp-title">The campaign</h2>
        <a class="link label" href="/campaigns">See it all</a>
      </header>
      <div class="camp__grid">
        {
          campaign.map((c) => (
            <figure class={`camp__item camp__item--${c.cls}`}>
              <Media
                name={c.name}
                alt={c.alt}
                ratio={c.ratio}
                position={'position' in c ? c.position : '50% 35%'}
                sizes={c.cls === 'c' ? '(min-width: 600px) 100vw, 222vw' : c.cls === 'a' ? '(min-width: 900px) 56vw, 100vw' : c.cls === 'e' ? '(min-width: 900px) 44vw, 82vw' : '(min-width: 900px) 32vw, 82vw'}
                scaleSizes={c.cls !== 'c'}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ THE FRAGRANCE ============ -->
  <section class="section theme-ivory scent" aria-labelledby="scent-title">
    <div class="wrap grid">
      <div class="scent__visual">
        <Media name="still-packshot" alt="The Unforgettable bottle: faceted clear glass, amber juice, a square black cap and a brass collar" ratio="4 / 5" sizes="(min-width: 900px) 46vw, 100vw" />
      </div>
      <div class="scent__info">
        <h2 class="h1 scent__name" id="scent-title" data-reveal="lines">{product.name}</h2>
        <p class="lead it muted">{product.concentration}</p>
        <p class="scent__text">{product.story[2]}</p>
        <Purchase product={product} id="buy-home" />
        <a class="link label" href="/fragrances/unforgettable">The fragrance in full</a>
      </div>
    </div>
  </section>

  <!-- ============ CLOSING ============ -->
  <section class="close" aria-labelledby="close-title">
    <picture class="close__media">
      <source media="(max-aspect-ratio: 4/5)" srcset={srcset(roomTallSet)} sizes="max(100vw, 56vh)" type="image/webp" />
      <source srcset={srcset(roomSet)} sizes="max(100vw, 178vh)" type="image/webp" />
      <img
        src={roomJpg.src}
        alt="The study after he has gone: the bottle on the desk in the lamplight, rain on the window"
        width={room.width}
        height={room.height}
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="close__shade" aria-hidden="true"></div>
    <div class="close__content wrap">
      <h2 class="display close__title" id="close-title" data-reveal="lines">The room <em>remembers.</em></h2>
      <a class="btn close__cta" href="/fragrances/unforgettable" data-reveal="fade">Discover Unforgettable</a>
    </div>
  </section>
</Base>

<style is:global>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    max-height: 72rem;
    overflow: hidden;
    background: var(--c-ink);
  }
  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    object-fit: cover;
    object-position: 64% 42%;
    animation: hero-in 1.6s var(--ease-out) both;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(10 9 8 / 0.5) 0%, transparent 16%),
      linear-gradient(to top, rgb(10 9 8 / 0.82) 0%, rgb(10 9 8 / 0.35) 34%, transparent 58%),
      linear-gradient(to right, rgb(10 9 8 / 0.55) 0%, transparent 46%);
  }
  .hero__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin-inline: auto;
    padding-bottom: clamp(2.5rem, 8svh, 5.5rem);
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .hero__kicker {
    color: rgb(239 231 216 / 0.82);
  }
  .hero__title {
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(3.1rem, 1.6rem + 6.2vw, 8.5rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__line > span {
    display: block;
  }
  .hero__cta {
    animation: hero-fade 1.2s var(--ease-out) 0.5s both;
  }
  .hero__kicker {
    animation: hero-fade 1.2s var(--ease-out) 0.2s both;
  }
  @keyframes hero-in {
    from {
      transform: scale(1.04);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  html:not(.motion) .hero__media img,
  html:not(.motion) .hero__cta,
  html:not(.motion) .hero__kicker {
    animation: none;
  }
  @media (max-aspect-ratio: 4/5) {
    .hero__media img {
      object-position: 60% 30%;
    }
    .hero__shade {
      background:
        linear-gradient(to bottom, rgb(10 9 8 / 0.55) 0%, transparent 14%),
        linear-gradient(to top, rgb(10 9 8 / 0.9) 0%, rgb(10 9 8 / 0.55) 30%, transparent 55%);
    }
  }

  /* ---------- the feeling ---------- */
  .feel .grid {
    row-gap: 2.5rem;
    align-items: center;
  }
  .feel__copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .feel__title {
    max-width: 14ch;
  }
  .feel__text {
    max-width: 30rem;
  }
  .feel__visual {
    grid-column: 1 / -1;
    margin-inline: calc(var(--gutter) * -1);
  }
  @media (min-width: 900px) {
    .feel__copy {
      grid-column: 1 / span 4;
    }
    .feel__visual {
      grid-column: 6 / -1;
      margin-inline: 0 calc(var(--gutter) * -1);
    }
  }

  /* ---------- the campaign ---------- */
  .camp {
    padding-top: 0;
  }
  .camp__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--c-line);
  }
  .camp__head h2 {
    color: var(--c-muted);
  }
  .camp__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  @media (max-width: 899px) {
    .camp__item--c {
      margin-inline: calc(var(--gutter) * -1);
    }
  }
  @media (max-width: 599px) {
    .camp__item--c .media {
      aspect-ratio: 4 / 5 !important;
    }
  }
  @media (max-width: 899px) {
    .camp__item--b,
    .camp__item--e {
      width: 82%;
      justify-self: end;
    }
    .camp__item--d {
      width: 82%;
    }
  }
  @media (min-width: 900px) {
    .camp__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: clamp(4rem, 8vw, 8rem);
      align-items: start;
    }
    .camp__item--a {
      grid-column: 1 / span 7;
    }
    .camp__item--b {
      grid-column: 9 / span 4;
      margin-top: 30%;
    }
    .camp__item--c {
      grid-column: 1 / -1;
    }
    .camp__item--c .media {
      aspect-ratio: 21 / 9 !important;
    }
    .camp__item--d {
      grid-column: 2 / span 4;
      margin-top: 18%;
    }
    .camp__item--e {
      grid-column: 7 / span 6;
    }
  }

  /* ---------- the fragrance ---------- */
  .scent .grid {
    row-gap: 2.5rem;
    align-items: center;
  }
  .scent__visual {
    grid-column: 1 / -1;
    margin-inline: calc(var(--gutter) * -1);
  }
  .scent__info {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 28rem;
  }
  .scent__name {
    font-size: clamp(3rem, 1.6rem + 4vw, 6rem);
  }
  .scent__text {
    color: var(--c-muted);
    margin-bottom: 0.75rem;
  }
  .scent .buy {
    width: 100%;
  }
  @media (min-width: 900px) {
    .scent__visual {
      grid-column: 1 / span 6;
      margin-inline: 0;
    }
    .scent__info {
      grid-column: 8 / span 4;
    }
  }

  /* ---------- closing ---------- */
  .close {
    position: relative;
    min-height: 100svh;
    max-height: 64rem;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--c-ink);
  }
  .close__media,
  .close__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .close__media img {
    object-fit: cover;
    object-position: 58% 50%;
  }
  @media (max-aspect-ratio: 4/5) {
    /* tall screens: the bottle sits low in the frame, so the line moves to the top */
    .close {
      align-items: start;
    }
    .close__media img {
      object-position: 50% 40%;
    }
    .close__shade {
      background: linear-gradient(to bottom, rgb(10 9 8 / 0.85) 0%, rgb(10 9 8 / 0.35) 38%, transparent 60%);
    }
    .close__content {
      padding-block: calc(var(--header-h) + 2rem) var(--section);
    }
  }
  .close__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 9 8 / 0.85) 0%, rgb(10 9 8 / 0.3) 40%, transparent 65%);
  }
  .close__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 2rem;
    padding-block: var(--section) clamp(3rem, 9svh, 6rem);
  }
  .close__title {
    font-size: clamp(3.4rem, 1.5rem + 7vw, 9.5rem);
    max-width: 8.5ch;
  }
</style>
