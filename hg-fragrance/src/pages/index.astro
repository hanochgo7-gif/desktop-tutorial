---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import FourLights from '../components/FourLights.astro';
import { getProduct } from '../data/catalog';
import { commerce } from '../config/site';
import { campaigns } from '../data/campaigns';

const moreCampaigns = campaigns
  .filter((c): c is typeof c & { loop: NonNullable<typeof c.loop> } => c.id !== 'unforgettable' && !!c.loop)
  .slice(0, 3);

const product = getProduct('unforgettable')!;
const fmt = new Intl.NumberFormat('en', { style: 'currency', currency: commerce.currency, maximumFractionDigits: 0 });
const from = Math.min(...product.variants.map((v) => v.price));
const defaultVariant = product.variants.find((v) => v.available)!;

const filmstrip = [
  { name: 'film-macro', t: '00:00', title: 'Glass', alt: 'Extreme close-up of the faceted HG bottle filled with amber' },
  { name: 'film-window', t: '00:02', title: 'The window', alt: 'A man in a dark suit at a tall rainy window at night, the HG bottle on the desk' },
  { name: 'film-ritual', t:'00:06', title: 'The ritual', alt: 'He sprays HG Unforgettable at the collar, a brass lamp glowing behind him' },
  { name: 'film-exit', t: '00:11', title: 'The door', alt: 'He leaves through a lit doorway; the desk lamp stays on' },
  { name: 'film-empty-room', t: '00:13', title: 'The room after', alt: 'The empty room: lamp, chair and the HG bottle on the desk, mist still in the air' },
] as const;

const chapters = [
  {
    img: 'film-desk',
    alt: 'The HG bottle on a walnut desk by a brass lamp, city lights blurred in the rain behind',
    title: 'Lamplight',
    text: 'Brass warms first. A circle of amber on a dark desk, and everything outside it waits its turn.',
  },
  {
    img: 'still-rain',
    alt: 'Raindrops running down a dark window, amber lamp light reflected in the glass',
    title: 'Rain',
    text: 'The city keeps its distance behind wet glass. Inside, the air is still enough to hold something.',
  },
  {
    img: 'still-skin',
    alt: 'Close view of a neck above an open white collar, lit amber from behind',
    title: 'Skin',
    text: 'Once, at the collar. Not to be noticed across a room — to be remembered in it.',
  },
  {
    img: 'still-travertine',
    alt: 'The HG bottle on an ivory travertine ledge in low morning sun, a long shadow behind it',
    title: 'Morning',
    text: 'By daylight the chair is cold and the lamp is off. The room is still not empty.',
  },
] as const;
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="home-hero" data-hero data-glass-area aria-labelledby="hero-title">
    <div class="home-hero__media" data-hero-media data-glass>
      <picture>
        <source media="(max-aspect-ratio: 4/5)" srcset="/media/hero-vertical-poster.webp" type="image/webp" />
        <source media="(max-aspect-ratio: 4/5)" srcset="/media/hero-vertical-poster.jpg" />
        <source srcset="/media/hero-desk-poster.webp" type="image/webp" />
        <img src="/media/hero-desk-poster.jpg" alt="" width="1600" height="893" fetchpriority="high" decoding="sync" />
      </picture>
      <video
        id="hero-video"
        data-ambient
        data-src="/media/hero-desk.mp4"
        data-src-portrait="/media/hero-vertical.mp4"
        muted
        playsinline
        loop
        preload="none"
        aria-hidden="true"
        tabindex="-1"></video>
    </div>
    <div class="home-hero__shade" aria-hidden="true"></div>

    <div class="home-hero__content wrap" data-hero-content>
      <p class="label home-hero__kicker" data-reveal="fade" data-immediate data-delay="0.6">
        <span>N°01</span><span class="home-hero__dash" aria-hidden="true"></span><span>Unforgettable</span>
      </p>
      <h1 class="home-hero__title" id="hero-title">
        <!-- CSS-driven reveal: starts at first paint, independent of the JS bundle (keeps LCP fast) -->
        <span class="home-hero__line"><span class="home-hero__in">Leave the room.</span></span>
        <span class="home-hero__line home-hero__line--it"><span class="home-hero__in"><em>Stay in it.</em></span></span>
      </h1>
      <div class="home-hero__aside" data-reveal="fade" data-immediate data-delay="1.2">
        <p class="muted">The first fragrance from HG — for the presence that remains after you have gone.</p>
        <div class="home-hero__ctas">
          <a class="btn btn--solid" href="/fragrances/unforgettable" data-magnetic>Discover<span class="arrow" aria-hidden="true"></span></a>
          <a class="btn" href="/film" data-open-film>Watch the film</a>
        </div>
      </div>
      <button class="home-hero__pause label" type="button" data-ambient-toggle aria-controls="hero-video">Pause</button>
      <a class="home-hero__scroll label" href="#prologue" aria-label="Scroll to the story">
        <span aria-hidden="true" class="home-hero__scroll-line"></span>
      </a>
    </div>
  </section>

  <!-- ============ PROLOGUE ============ -->
  <section class="section home-prologue" id="prologue" aria-labelledby="prologue-title">
    <div class="wrap grid">
      <p class="label faint home-prologue__label" data-reveal="fade">Prologue</p>
      <h2 class="h2 home-prologue__text" id="prologue-title" data-reveal="lines">
        Some presences end at the door. Others take the chair you left, the lamp still warm, the window still raining.
        <em class="brass">HG is made for the second kind.</em>
      </h2>
      <div class="home-prologue__still">
        <Media name="still-cap" alt="Macro of the HG bottle: matte black cap, brass collar and bevelled glass shoulder" ratio="1 / 1" sizes="(min-width: 900px) 22vw, 60vw" parallax={6} />
        <p class="media-cap label"><span>Detail</span><span>Cap, collar, glass</span></p>
      </div>
    </div>
  </section>

  <!-- ============ EDITORIAL COLLAGE ============ -->
  <section class="home-collage" aria-labelledby="collage-title">
    <div class="wrap">
      <header class="home-collage__head grid">
        <p class="label faint" data-reveal="fade">Editorial — Nocturne</p>
        <h2 class="h1" id="collage-title" data-reveal="lines">Amber, glass <em>&amp; rain</em></h2>
      </header>
    </div>

    <div class="home-collage__stage">
      <p class="home-collage__word" aria-hidden="true"><span data-drift="-38">Unforgettable — Unforgettable —</span></p>

      <div class="home-collage__grid wrap">
        <figure class="cg cg--a" data-speed="0.04">
          <Media name="still-basalt" alt="The HG bottle alone on a block of dark basalt, a single raking light breaking amber across the stone" ratio="4 / 5" sizes="(min-width: 900px) 38vw, 70vw" parallax={6} />
          <figcaption class="media-cap label"><span>01</span><span>Basalt</span></figcaption>
        </figure>

        <figure class="cg cg--b" data-speed="0.16">
          <Media name="still-monogram" alt="The engraved HG monogram seen through amber liquid" ratio="4 / 5" sizes="(min-width: 900px) 24vw, 46vw" />
          <figcaption class="media-cap label"><span>02</span><span>Monogram</span></figcaption>
        </figure>

        <figure class="cg cg--c" data-speed="0.28">
          <Media name="still-rain" alt="Rain on a night window" ratio="3 / 4" sizes="(min-width: 900px) 14vw, 30vw" />
        </figure>

        <blockquote class="cg cg--quote" data-speed="0.08">
          <p class="h3" data-reveal="lines">“The room keeps what you leave in it.”</p>
          <footer class="label faint" data-reveal="fade">— From the film</footer>
        </blockquote>

        <figure class="cg cg--d" data-speed="-0.04">
          <Media name="film-window" alt="Still from the film: a man at a tall rain-streaked window, the city lit below" ratio="16 / 9" sizes="(min-width: 900px) 56vw, 92vw" parallax={5} cursor="Film" />
          <figcaption class="media-cap label"><span>03</span><span>The window — still from the film</span></figcaption>
        </figure>

        <figure class="cg cg--e" data-speed="0.18">
          <Media name="still-skin" alt="The open collar of a white shirt, skin lit amber by a lamp" ratio="3 / 4" sizes="(min-width: 900px) 22vw, 44vw" />
          <figcaption class="media-cap label"><span>04</span><span>Collar</span></figcaption>
        </figure>

        <figure class="cg cg--f" data-speed="0.06">
          <div class="media" data-reveal="mask" style="aspect-ratio:4/5">
            <video data-ambient data-src="/media/macro.mp4" data-poster="/media/macro-poster.jpg" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>
          </div>
          <figcaption class="media-cap label"><span>05</span><span>Bevel, in motion</span></figcaption>
        </figure>

        <figure class="cg cg--g" data-speed="-0.08">
          <Media name="still-mist" alt="A plume of fine mist drifting through a single beam of amber light" ratio="16 / 9" sizes="(min-width: 900px) 40vw, 80vw" />
          <figcaption class="media-cap label"><span>06</span><span>What stays in the air</span></figcaption>
        </figure>

        <figure class="cg cg--h" data-speed="0.2">
          <Media name="film-look" alt="Still from the film: a man’s face in low light, looking back" ratio="4 / 5" sizes="(min-width: 900px) 20vw, 40vw" position="40% 50%" />
          <figcaption class="media-cap label"><span>07</span><span>The look</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ SIGNATURE FRAGRANCE ============ -->
  <section class="section home-signature" aria-labelledby="signature-title">
    <div class="wrap grid">
      <div class="home-signature__visual">
        <Media name="still-mirror" alt="The HG Unforgettable bottle on black lacquer, mirrored below" ratio="3 / 4" sizes="(min-width: 900px) 45vw, 100vw" parallax={7} cursor="Discover" />
      </div>
      <div class="home-signature__copy">
        <p class="label brass" data-reveal="fade">{product.number} — The signature</p>
        <h2 class="h1" id="signature-title" data-reveal="lines">{product.name}</h2>
        <p class="lead muted it" data-reveal="fade">{product.concentration}</p>
        <div class="prose" data-reveal="fade">
          <p>{product.story[1]}</p>
          <p>{product.story[2]}</p>
        </div>
        <dl class="home-signature__facts" data-reveal="fade">
          <div><dt class="label faint">Formats</dt><dd>{product.variants.map((v) => v.label).join(' · ')}</dd></div>
          <div><dt class="label faint">From</dt><dd>{fmt.format(from)}{!commerce.pricesConfirmed && <span class="faint home-signature__note"> — launch pricing to be confirmed</span>}</dd></div>
        </dl>
        <div class="home-signature__ctas" data-reveal="fade">
          <a class="btn btn--solid" href="/fragrances/unforgettable" data-magnetic>Discover {product.name}<span class="arrow" aria-hidden="true"></span></a>
          <form data-add-to-bag>
            <input type="hidden" name="variant" value={defaultVariant.id} />
            <input type="hidden" name="qty" value="1" />
            <button class="btn" type="submit">Add {defaultVariant.label} — {fmt.format(defaultVariant.price)}</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ONE FLACON, FOUR LIGHTS (signature sequence) ============ -->
  <FourLights />

  <!-- ============ SENSORY CHAPTERS (ivory) ============ -->
  <section class="section home-hours theme-ivory" aria-labelledby="hours-title" data-chapters>
    <div class="wrap">
      <header class="home-hours__head grid">
        <p class="label faint" data-reveal="fade">Four hours of Unforgettable</p>
        <h2 class="h1" id="hours-title" data-reveal="lines">From lamplight <em>to morning</em></h2>
      </header>
      <div class="home-hours__body grid">
        <div class="home-hours__sticky" aria-hidden="true">
          <div class="home-hours__frames">
            {
              chapters.map((c, i) => (
                <div class={`home-hours__frame${i === 0 ? ' is-active' : ''}`} data-chapter-frame={String(i)}>
                  <Media name={c.img} alt="" ratio="4 / 5" sizes="(min-width: 900px) 42vw, 1px" reveal={false} />
                </div>
              ))
            }
          </div>
          <p class="home-hours__index"><span class="num" data-chapter-index>01</span><span class="faint"> / 04</span></p>
        </div>
        <ol class="home-hours__list" role="list">
          {
            chapters.map((c, i) => (
              <li class={`home-hours__chapter${i === 0 ? ' is-active' : ''}`} data-chapter={String(i)}>
                <div class="home-hours__inline">
                  <Media name={c.img} alt={c.alt} ratio="4 / 5" sizes="(max-width: 899px) 90vw, 1px" />
                </div>
                <p class="label faint">{['I', 'II', 'III', 'IV'][i]}</p>
                <h3 class="h2" data-reveal="lines">{c.title}</h3>
                <p class="lead home-hours__text" data-reveal="fade">{c.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ THE HOUSE ============ -->
  <section class="home-house" aria-labelledby="house-title">
    <div class="home-house__knockout" aria-hidden="true">
      <video data-ambient data-src="/media/macro.mp4" data-poster="/media/macro-poster.jpg" muted playsinline loop preload="none" tabindex="-1"></video>
      <p class="home-house__letters">HG</p>
    </div>
    <div class="wrap grid home-house__copy">
      <p class="label faint" data-reveal="fade">The House</p>
      <h2 class="h2" id="house-title" data-reveal="lines">A house of few words.</h2>
      <div class="prose" data-reveal="fade">
        <p>Four fragrances, one bottle, one room through the year. HG works the way an editor cuts a scene — keeping only what has to be there, and giving it room.</p>
      </div>
      <a class="link label" href="/house" data-reveal="fade">Enter the house</a>
    </div>
  </section>

  <!-- ============ THE FILM ============ -->
  <section class="section home-film" aria-labelledby="film-title">
    <div class="wrap">
      <header class="home-film__head">
        <div>
          <p class="label faint" data-reveal="fade">The film — 0:20</p>
          <h2 class="h1" id="film-title" data-reveal="lines">Unforgettable, <em>in five scenes</em></h2>
        </div>
        <a class="btn" href="/film" data-open-film data-reveal="fade">Play the film</a>
      </header>
      <ol class="home-film__strip" role="list">
        {
          filmstrip.map((f, i) => (
            <li class={`home-film__item home-film__item--${i + 1}`}>
              <a href="/film" data-open-film class="home-film__link">
                <Media name={f.name} alt={f.alt} ratio={i % 2 ? '4 / 5' : '3 / 4'} sizes="(min-width: 900px) 20vw, 62vw" cursor="Play" />
                <span class="media-cap label"><span class="visually-hidden">Play the film from</span><span class="num">{f.t}</span><span>{f.title}</span></span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="home-film__more"><a class="link label" href="/film#gallery">The campaign gallery</a></p>
    </div>
  </section>

  <!-- ============ MORE CAMPAIGNS ============ -->
  <section class="section home-camps" aria-labelledby="camps-title">
    <div class="wrap">
      <header class="home-camps__head grid">
        <p class="label faint" data-reveal="fade">The campaigns</p>
        <h2 class="h1" id="camps-title" data-reveal="lines">Elsewhere, <em>the same night</em></h2>
        <a class="link label home-camps__all" href="/campaigns" data-reveal="fade">All campaigns</a>
      </header>
      <ul class="home-camps__list" role="list">
        {
          moreCampaigns.map((c, i) => (
            <li class={`home-camps__item home-camps__item--${i + 1}`}>
              <a class="home-camps__card" href={`/campaigns#${c.id}`} data-cursor="Watch">
                <div class="media home-camps__media" data-reveal="mask">
                  <video
                    id={`camp-loop-${c.id}`}
                    data-ambient
                    data-src={c.loop.src}
                    data-poster={c.loop.poster}
                    muted
                    playsinline
                    loop
                    preload="none"
                    aria-hidden="true"
                    tabindex="-1"
                  />
                </div>
                <span class="home-camps__meta">
                  <span class="label brass">Chapter {c.number}</span>
                  <span class="h3">{c.title}</span>
                  <span class="muted home-camps__line">{c.line}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* ---------- hero ---------- */
  .home-hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    background: var(--c-ink);
    isolation: isolate;
  }
  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
    transform-origin: 70% 50%;
  }
  /* Landscape: widen the frame past the right edge so the bottle sits clear of the type. */
  @media (min-aspect-ratio: 4/5) {
    .home-hero__media {
      inset-inline-end: -16%;
    }
  }
  .home-hero__media img,
  .home-hero__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 50%;
  }
  .home-hero__media video {
    opacity: 0;
    transition: opacity 1.4s var(--ease-soft);
  }
  .home-hero__media video.is-playing {
    opacity: 1;
  }
  .home-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(to top, rgb(10 9 8 / 0.92) 0%, rgb(10 9 8 / 0.35) 38%, rgb(10 9 8 / 0) 62%),
      linear-gradient(to right, rgb(10 9 8 / 0.55), rgb(10 9 8 / 0) 55%);
  }
  .home-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-ink);
    opacity: 0;
    pointer-events: none;
  }
  .home-hero__content {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto auto;
    column-gap: var(--gap);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(2rem, 5vh, 4rem);
  }
  .home-hero__kicker {
    grid-column: 1 / -1;
    align-self: start;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--c-muted);
  }
  .home-hero__dash {
    width: 3rem;
    height: 1px;
    background: var(--c-line-strong);
  }
  .home-hero__title {
    grid-column: 1 / -1;
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: min(clamp(3.2rem, 0.8rem + 9vw, 10.5rem), 17svh);
    line-height: 0.88;
    letter-spacing: -0.035em;
  }
  .home-hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .home-hero__in {
    display: inline-block;
  }
  html.motion .home-hero__in {
    animation: hero-rise 1.7s var(--ease-out) 0.25s both;
  }
  html.motion .home-hero__line--it .home-hero__in {
    animation-delay: 0.55s;
  }
  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
  }
  .home-hero__line--it {
    padding-inline-start: 0.9em;
    color: var(--c-ivory);
  }
  .home-hero__aside {
    grid-column: 1 / -1;
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
    max-width: 26rem;
  }
  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .home-hero__scroll {
    display: none;
  }
  .home-hero__pause {
    position: absolute;
    inset-inline-end: var(--gutter);
    top: calc(var(--header-h) + 1.6rem);
    min-height: 2.75rem;
    min-width: 2.75rem;
    color: var(--c-muted);
    transition: color var(--dur-2);
  }
  .home-hero__pause:hover {
    color: var(--c-ivory);
  }
  /* Portrait phones: the bottle owns the lower half, so type sits up top and actions at the foot. */
  @media (max-aspect-ratio: 4/5) {
    .home-hero__content {
      grid-template-rows: auto auto 1fr auto;
    }
    .home-hero__title {
      grid-row: 2;
      margin-top: 1.2rem;
      font-size: clamp(3rem, 15.5vw, 6.5rem);
    }
    .home-hero__aside {
      grid-row: 4;
      max-width: none;
      gap: 1rem;
    }
    .home-hero__aside p {
      display: none;
    }
    .home-hero__ctas .btn {
      flex: 1;
      padding-inline: 1rem;
    }
    .home-hero__shade {
      background:
        linear-gradient(to bottom, rgb(10 9 8 / 0.75) 0%, rgb(10 9 8 / 0) 38%),
        linear-gradient(to top, rgb(10 9 8 / 0.85) 0%, rgb(10 9 8 / 0) 24%);
    }
  }
  @media (min-width: 900px) and (min-aspect-ratio: 4/5) {
    .home-hero__title {
      grid-column: 1 / span 8;
      grid-row: 2;
      align-self: end;
    }
    .home-hero__aside {
      grid-column: 1 / span 8;
      grid-row: 3;
      display: flex;
      align-items: center;
      gap: 2.5rem;
      max-width: none;
      margin-top: 2.25rem;
    }
    .home-hero__aside p {
      max-width: 19rem;
      font-size: var(--step--1);
    }
    .home-hero__scroll {
      display: block;
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 1px;
      height: 5.5rem;
      overflow: hidden;
    }
    .home-hero__scroll-line {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent, var(--c-ivory));
      animation: scroll-cue 2.4s var(--ease-in-out) infinite;
    }
  }
  @keyframes scroll-cue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  /* ---------- prologue ---------- */
  .home-prologue__label {
    grid-column: 1 / -1;
    margin-bottom: 1.5rem;
  }
  .home-prologue__text {
    grid-column: 1 / -1;
    font-size: clamp(2rem, 1.3rem + 2.9vw, 4.4rem);
    line-height: 1.08;
  }
  .home-prologue__still {
    grid-column: 4 / -1;
    margin-top: clamp(3rem, 7vw, 6rem);
    max-width: 22rem;
  }
  @media (min-width: 900px) {
    .home-prologue__label {
      grid-column: 1 / span 2;
      padding-top: 1.2rem;
    }
    .home-prologue__text {
      grid-column: 3 / span 10;
      text-indent: 3em;
    }
    .home-prologue__still {
      grid-column: 9 / span 3;
    }
  }

  /* ---------- collage ---------- */
  .home-collage {
    position: relative;
    padding-bottom: var(--section);
    overflow: clip;
  }
  .home-collage__head {
    row-gap: 1rem;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }
  .home-collage__head > * {
    grid-column: 1 / -1;
  }
  .home-collage__stage {
    position: relative;
  }
  .home-collage__word {
