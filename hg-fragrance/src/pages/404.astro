---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="state-page">
    <div class="wrap">
      <p class="label faint">404</p>
      <h1 class="display" style="font-size:clamp(3rem,1rem + 8vw,10rem)">This room <em>is empty.</em></h1>
      <p class="lead muted">The page you were looking for has left.</p>
      <a class="btn btn--solid" href="/">Return to HG<span class="arrow" aria-hidden="true"></span></a>
    </div>
  </section>
</Base>
