---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Lightbox from '../components/Lightbox.astro';
import { img } from '../assets/images';
import { bySeason } from '../data/catalog';

/**
 * The campaign: one curated sequence. Rows pair two portraits (large + small, alternating sides)
 * and break with a full-width frame; no two neighbours share a model or a pose.
 */
type Frame = { name: string; alt: string; position?: string };
type Row = { kind: 'wide'; frame: Frame } | { kind: 'pair'; flip?: boolean; frames: [Frame, Frame] };

const rows: Row[] = [
  { kind: 'wide', frame: { name: 'cupra-promenade', alt: 'Unforgettable on the balustrade of a seafront promenade at night, the CUPRA Leon parked under the iron lamps behind', position: '40% 50%' } },
  {
    kind: 'pair',
    frames: [
      { name: 'cupra-golden', alt: 'Unforgettable on the stone kerb of a coastal road at golden hour, a grey-beige CUPRA Leon behind it and the sea gold beyond', position: '50% 50%' },
      { name: 'cupra-rear', alt: 'Unforgettable on the wet tailgate of the CUPRA Leon, beside the glowing red light bar and copper logo', position: '55% 40%' },
    ],
  },
  { kind: 'wide', frame: { name: 'cupra-coast', alt: 'The grey-beige CUPRA Leon on a cliff road above the sea at sunset', position: '55% 50%' } },
];

/** The four seasons: one fashion portrait per fragrance, spring → winter. */
const seasons = bySeason().map((p) => ({ ...p.portrait, slug: p.slug, number: p.number, product: p.name, season: p.season }));

const frames = [...rows.flatMap((r) => (r.kind === 'wide' ? [r.frame] : r.frames)), ...seasons];
const full = Object.fromEntries(
  await Promise.all(frames.map(async (f) => [f.name, (await getImage({ src: img(f.name), width: 2000, format: 'webp', quality: 82 })).src])),
);
---

<Base title="The Campaign" description="The HG campaign.">
  <section class="cp" aria-labelledby="cp-title">
    <div class="wrap">
      <header class="cp__head">
        <h1 class="display cp__title" id="cp-title">The campaign</h1>
        <p class="lead it muted">Leave the room. Stay in it.</p>
      </header>

      <div class="cp__rows">
        {
          rows.map((r) =>
            r.kind === 'wide' ? (
              <div class="cp__wide">
                <button type="button" class="cp__btn" data-lightbox="campaign" data-full={full[r.frame.name]} data-alt={r.frame.alt} data-caption="" aria-label={`View: ${r.frame.alt}`}>
                  <Media name={r.frame.name} alt={r.frame.alt} ratio="16 / 9" sizes="(min-width: 600px) 100vw, 222vw" scaleSizes={false} position={r.frame.position} />
                </button>
              </div>
            ) : (
              <div class:list={['cp__pair', { 'cp__pair--flip': r.flip }]}>
                {r.frames.map((f, i) => (
                  <button type="button" class:list={['cp__btn', i === 0 ? 'cp__big' : 'cp__small']} data-lightbox="campaign" data-full={full[f.name]} data-alt={f.alt} data-caption="" aria-label={`View: ${f.alt}`}>
                    <Media name={f.name} alt={f.alt} ratio={i === 0 ? '4 / 5' : '3 / 4'} sizes={i === 0 ? '(min-width: 900px) 52vw, 100vw' : '(min-width: 900px) 32vw, 78vw'} position={f.position} />
                  </button>
                ))}
              </div>
            ),
          )
        }
      </div>

      <section class="cp__seasons" aria-labelledby="cp-seasons">
        <header class="cp__seasons-head">
          <p class="label muted">One flacon, four lights</p>
          <h2 class="h2" id="cp-seasons" data-reveal="lines">The four seasons</h2>
        </header>
        <div class="cp__seasons-body">
        <div class="cp__film" data-reveal="fade">
          <picture>
            <source srcset="/media/four-seasons-film-poster.webp" type="image/webp" />
            <img src="/media/four-seasons-film-poster.jpg" alt="The four seasons: four men in linen and silk walk a sunlit concrete courtyard, each with his HG fragrance" width="1080" height="1920" loading="lazy" decoding="async" />
          </picture>
          <video id="seasons-film" data-ambient data-src="/media/four-seasons-film.mp4" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>
          <button class="cp__film-pause label" type="button" data-ambient-toggle aria-controls="seasons-film">Pause</button>
        </div>
        <ul class="cp__quartet" role="list">
          {
            seasons.map((f) => (
              <li class="cp__season">
                <button type="button" class="cp__btn" data-lightbox="campaign" data-full={full[f.name]} data-alt={f.alt} data-caption={`${f.number} ${f.product} — ${f.season}`} aria-label={`View: ${f.alt}`}>
                  <Media name={f.name} alt={f.alt} ratio="3 / 4" sizes="(min-width: 900px) 28vw, 46vw" position={f.focus} />
                </button>
                <a class="cp__season-cap" href={`/fragrances/${f.slug}`}>
                  <span class="label muted">{f.number} · {f.season}</span>
                  <span class="cp__season-name">{f.product}</span>
                </a>
              </li>
            ))
          }
        </ul>
        </div>
      </section>

      <footer class="cp__end">
        <p class="h2" data-reveal="lines">HG</p>
        <div class="cp__ctas" data-reveal="fade">
          <a class="btn btn--solid" href="/fragrances/unforgettable">Discover Unforgettable</a>
          <a class="link label" href="/film" data-open-film>Watch the film</a>
        </div>
      </footer>
    </div>
  </section>
  <Lightbox />
</Base>

<style is:global>
  .cp {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 6rem));
    padding-bottom: var(--section);
  }
  .cp__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .cp__title {
    font-size: clamp(3.4rem, 1.2rem + 8vw, 11rem);
  }
  .cp__rows {
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
  }
  .cp__btn {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }
  .cp__btn img {
    transition: transform 1.6s var(--ease-out);
  }
  .cp__btn:hover img {
    transform: scale(1.025);
  }
  .cp__wide {
    margin-inline: calc(var(--gutter) * -1);
  }
  .cp__pair {
    display: grid;
    gap: clamp(1.5rem, 6vw, 3rem);
  }
  .cp__small {
    width: 78%;
    justify-self: end;
  }
  @media (max-width: 599px) {
    .cp__wide .media {
      aspect-ratio: 4 / 5 !important;
    }
  }
  @media (min-width: 900px) {
    .cp__wide {
      margin-inline: 0;
    }
    .cp__pair {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: end;
    }
    .cp__big {
      grid-column: 1 / span 7;
    }
    .cp__small {
      grid-column: 9 / span 4;
      width: 100%;
      align-self: start;
      margin-top: 22%;
    }
    .cp__pair--flip .cp__big {
      grid-column: 6 / span 7;
      grid-row: 1;
    }
    .cp__pair--flip .cp__small {
      grid-column: 1 / span 4;
      grid-row: 1;
    }
  }
  .cp__seasons {
    margin-top: var(--section);
  }
  .cp__seasons-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .cp__quartet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 3rem) clamp(0.75rem, 3vw, var(--gap));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cp__season {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .cp__season-cap {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }
  .cp__season-name {
    font-family: var(--f-serif);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.1;
  }
  .cp__season-cap:hover .cp__season-name {
    font-style: italic;
  }
  .cp__seasons-body {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .cp__film {
    position: relative;
    width: min(100%, calc(84svh * 9 / 16));
    aspect-ratio: 9 / 16;
    margin-inline: auto;
    overflow: hidden;
    background: var(--c-ink);
  }
  .cp__film img,
  .cp__film video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cp__film video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-soft);
  }
  .cp__film video.is-playing {
    opacity: 1;
  }
  .cp__film-pause {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    color: rgb(239 231 216 / 0.8);
    background: rgb(10 9 8 / 0.35);
    transition: color var(--dur-2);
  }
  .cp__film-pause:hover {
    color: var(--c-ivory);
  }
  @media (min-width: 900px) {
    .cp__seasons-body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }
    .cp__film {
      grid-column: 1 / span 5;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
    .cp__quartet {
      grid-column: 7 / span 6;
    }
    .cp__season:nth-child(even) {
      margin-top: 18%;
    }
  }
  .cp__end {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.75rem;
    margin-top: var(--section);
  }
  .cp__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
  }
</style>
