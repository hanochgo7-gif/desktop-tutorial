---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Lightbox from '../components/Lightbox.astro';
import { img } from '../assets/images';

/**
 * The campaign: one curated sequence. Rows pair two portraits (large + small, alternating sides)
 * and break with a full-width frame; no two neighbours share a model or a pose.
 */
type Frame = { name: string; alt: string; position?: string };
type Row = { kind: 'wide'; frame: Frame } | { kind: 'pair'; flip?: boolean; frames: [Frame, Frame] };

const rows: Row[] = [
  { kind: 'wide', frame: { name: 'drv-rain-glass', alt: 'Seen through the rain-beaded window of a black car, he sits at the wheel while the lit bay reflects across the glass', position: '62% 45%' } },
  {
    kind: 'pair',
    frames: [
      { name: 'face-m1', alt: 'In a dark study by a rain-streaked window, a man in a black shirt holds Unforgettable at his chest', position: '50% 30%' },
      { name: 'face-m4', alt: 'A man in a black silk shirt holds Unforgettable up to the light', position: '50% 30%' },
    ],
  },
  { kind: 'wide', frame: { name: 'nc-village', alt: 'A man in a black overcoat beside a black sports car on a snowy alpine street at night, holding Nocturne', position: '70% 45%' } },
  {
    kind: 'pair',
    flip: true,
    frames: [
      { name: 'ow-coupe', alt: 'A woman in an ivory silk dress beside a pale sage-green classic coupe at a lakeside villa, holding Open Window', position: '50% 35%' },
      { name: 'll-pier', alt: 'A man with sea-wet hair on a stone pier, a wooden boat behind, holding Last Light', position: '50% 30%' },
    ],
  },
  { kind: 'wide', frame: { name: 'film-window', alt: 'In the study at night he stands at a tall rain-streaked window, the bottle on the desk beside the lamp', position: '60% 45%' } },
  {
    kind: 'pair',
    frames: [
      { name: 'unf-portrait', alt: 'A man in a black jacket holds Unforgettable up to the light', position: '50% 30%' },
      { name: 'riv-dressing', alt: 'In a dim dressing room he holds Unforgettable, his reflection in the mirror behind', position: '58% 40%' },
    ],
  },
  { kind: 'wide', frame: { name: 'ow-morning', alt: 'A man in a cream knit at tall open French windows above a misty lake, holding Open Window', position: '55% 40%' } },
  { kind: 'wide', frame: { name: 'unf-empty-study', alt: 'The empty study after he has gone: the bottle on the desk, mist in the lamplight', position: '58% 50%' } },
];

const frames = rows.flatMap((r) => (r.kind === 'wide' ? [r.frame] : r.frames));
const full = Object.fromEntries(
  await Promise.all(frames.map(async (f) => [f.name, (await getImage({ src: img(f.name), width: 2000, format: 'webp', quality: 82 })).src])),
);
---

<Base title="The Campaign" description="The HG campaign.">
  <section class="cp" aria-labelledby="cp-title">
    <div class="wrap">
      <header class="cp__head">
        <h1 class="display cp__title" id="cp-title">The campaign</h1>
        <p class="lead it muted">Leave the room. Stay in it.</p>
      </header>

      <div class="cp__rows">
        {
          rows.map((r) =>
            r.kind === 'wide' ? (
              <div class="cp__wide">
                <button type="button" class="cp__btn" data-lightbox="campaign" data-full={full[r.frame.name]} data-alt={r.frame.alt} data-caption="" aria-label={`View: ${r.frame.alt}`}>
                  <Media name={r.frame.name} alt={r.frame.alt} ratio="16 / 9" sizes="(min-width: 600px) 100vw, 222vw" scaleSizes={false} position={r.frame.position} />
                </button>
              </div>
            ) : (
              <div class:list={['cp__pair', { 'cp__pair--flip': r.flip }]}>
                {r.frames.map((f, i) => (
                  <button type="button" class:list={['cp__btn', i === 0 ? 'cp__big' : 'cp__small']} data-lightbox="campaign" data-full={full[f.name]} data-alt={f.alt} data-caption="" aria-label={`View: ${f.alt}`}>
                    <Media name={f.name} alt={f.alt} ratio={i === 0 ? '4 / 5' : '3 / 4'} sizes={i === 0 ? '(min-width: 900px) 52vw, 100vw' : '(min-width: 900px) 32vw, 78vw'} position={f.position} />
                  </button>
                ))}
              </div>
            ),
          )
        }
      </div>

      <footer class="cp__end">
        <p class="h2" data-reveal="lines">HG</p>
        <div class="cp__ctas" data-reveal="fade">
          <a class="btn btn--solid" href="/fragrances/unforgettable">Discover Unforgettable</a>
          <a class="link label" href="/film" data-open-film>Watch the film</a>
        </div>
      </footer>
    </div>
  </section>
  <Lightbox />
</Base>

<style is:global>
  .cp {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 6rem));
    padding-bottom: var(--section);
  }
  .cp__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .cp__title {
    font-size: clamp(3.4rem, 1.2rem + 8vw, 11rem);
  }
  .cp__rows {
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
  }
  .cp__btn {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }
  .cp__btn img {
    transition: transform 1.6s var(--ease-out);
  }
  .cp__btn:hover img {
    transform: scale(1.025);
  }
  .cp__wide {
    margin-inline: calc(var(--gutter) * -1);
  }
  .cp__pair {
    display: grid;
    gap: clamp(1.5rem, 6vw, 3rem);
  }
  .cp__small {
    width: 78%;
    justify-self: end;
  }
  @media (max-width: 599px) {
    .cp__wide .media {
      aspect-ratio: 4 / 5 !important;
    }
  }
  @media (min-width: 900px) {
    .cp__wide {
      margin-inline: 0;
    }
    .cp__pair {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: end;
    }
    .cp__big {
      grid-column: 1 / span 7;
    }
    .cp__small {
      grid-column: 9 / span 4;
      width: 100%;
      align-self: start;
      margin-top: 22%;
    }
    .cp__pair--flip .cp__big {
      grid-column: 6 / span 7;
      grid-row: 1;
    }
    .cp__pair--flip .cp__small {
      grid-column: 1 / span 4;
      grid-row: 1;
    }
  }
  .cp__end {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.75rem;
    margin-top: var(--section);
  }
  .cp__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
  }
</style>
