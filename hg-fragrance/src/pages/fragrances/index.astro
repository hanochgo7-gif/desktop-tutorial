---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import SeasonsGrid from '../../components/SeasonsGrid.astro';
import { bySeason, fromPrice } from '../../data/catalog';
import { commerce } from '../../config/site';

const items = bySeason();
const fmt = new Intl.NumberFormat('en', { style: 'currency', currency: commerce.currency, maximumFractionDigits: 0 });

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'HG — The Four Seasons',
  itemListElement: items.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/fragrances/${p.slug}`, Astro.site).toString(),
    name: `HG ${p.name}`,
  })),
};
---

<Base
  title="The Collection"
  description="The HG collection: four fragrances, one for each season — Open Window, Last Light, Unforgettable and Nocturne."
  jsonLd={ld}
>
  <section class="coll" aria-labelledby="coll-title">
    <div class="wrap">
      <header class="coll__head grid">
        <p class="label faint" data-reveal="fade" data-immediate>The Collection</p>
        <h1 class="display coll__title" id="coll-title" data-reveal="lines" data-immediate data-delay="0.1">
          Four seasons. <em>One house.</em>
        </h1>
        <p class="lead muted coll__intro" data-reveal="fade" data-immediate data-delay="0.5">
          One flacon, four temperatures of the same room: the window opened in spring, the last light of summer, the lamp
          left on in autumn, the fire in winter.
        </p>
      </header>
      <SeasonsGrid headingLevel="h2" />
    </div>

    {
      items.map((p, i) => {
        const visual = p.campaign[0];
        const price = fromPrice(p);
        return (
          <article class:list={['coll-row', { 'coll-row--flip': i % 2 === 1 }]} aria-labelledby={`row-${p.slug}`} style={`--accent:${p.accent}`}>
            <div class="wrap grid">
              <a class="coll-row__visual" href={`/fragrances/${p.slug}`} tabindex="-1" aria-hidden="true" data-cursor="Discover">
                <Media name={visual.name} alt="" ratio="4 / 5" sizes="(min-width: 900px) 42vw, 100vw" position={visual.focus ?? '50% 40%'} parallax={5} />
              </a>
              <div class="coll-row__copy">
                <p class="label coll-row__season" data-reveal="fade">
                  <span class="coll-row__dot" aria-hidden="true" />
                  {p.season} <span class="faint">· {p.number}</span>
                </p>
                <h2 class="h1 coll-row__name" id={`row-${p.slug}`} data-reveal="lines">
                  <a href={`/fragrances/${p.slug}`}>{p.name}</a>
                </h2>
                <p class="lead it muted" data-reveal="fade">{p.concentration}</p>
                <p class="prose" data-reveal="fade">{p.story[0]}</p>
                {p.notes && (
                  <p class="coll-row__notes" data-reveal="fade">
                    <span class="label faint">Notes</span>
                    <span class="serif">{[p.notes.top[0], p.notes.heart[0], p.notes.base[0]].join(' · ')}</span>
                  </p>
                )}
                <p class="label coll-row__status" data-reveal="fade">
                  {p.status === 'available' && price !== null ? (
                    <>
                      From {fmt.format(price)}
                      {!commerce.pricesConfirmed && <span class="faint"> — launch pricing to be confirmed</span>}
                    </>
                  ) : (
                    <span class="faint">Coming soon</span>
                  )}
                </p>
                <a class="btn btn--solid" href={`/fragrances/${p.slug}`} data-reveal="fade" data-magnetic>
                  Discover {p.name}<span class="arrow" aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>
</Base>

<style is:global>
  .coll {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
    padding-bottom: var(--section);
  }
  .coll__head {
    row-gap: 1.5rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .coll__head > * {
    grid-column: 1 / -1;
  }
  .coll__title {
    font-size: clamp(3rem, 1.4rem + 7vw, 10.5rem);
  }
  .coll__intro {
    max-width: 38rem;
  }
  .coll-row {
    margin-top: var(--section);
  }
  .coll-row .grid {
    row-gap: 2.5rem;
    align-items: center;
  }
  .coll-row__visual,
  .coll-row__copy {
    grid-column: 1 / -1;
  }
  .coll-row__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .coll-row__season {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .coll-row__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .coll-row__name {
    font-size: clamp(3rem, 1.2rem + 4.4vw, 6.25rem);
  }
  .coll-row__name a {
    transition: color var(--dur-2);
  }
  .coll-row__name a:hover {
    color: var(--accent);
  }
  .coll-row__notes {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    border-block: 1px solid var(--c-line);
    width: 100%;
  }
  .coll-row__notes .serif {
    font-size: var(--step-1);
  }
  @media (min-width: 900px) {
    .coll__head > p.label {
      grid-column: 1 / span 3;
      padding-top: 1.6rem;
    }
    .coll__head > h1,
    .coll__head > .coll__intro {
      grid-column: 4 / -1;
    }
    .coll-row__visual {
      grid-column: 1 / span 6;
    }
    .coll-row__copy {
      grid-column: 8 / span 5;
    }
    .coll-row--flip .coll-row__visual {
      grid-column: 7 / span 6;
      grid-row: 1;
    }
    .coll-row--flip .coll-row__copy {
      grid-column: 1 / span 5;
      grid-row: 1;
    }
  }
</style>
