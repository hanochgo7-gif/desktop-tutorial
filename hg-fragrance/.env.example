# Public origin used for canonical URLs, sitemap and Stripe redirects.
SITE_URL=https://www.example.com

# Stripe — server-side only. Use a test key (sk_test_…) until launch.
# Without it, checkout answers "Online payment is not enabled yet" and charges nothing.
STRIPE_SECRET_KEY=

# Newsletter — POSTs { email, source, at } as JSON to your ESP / automation webhook.
NEWSLETTER_WEBHOOK_URL=

# Alternative to the webhook on a persistent Node host: append sign-ups to a JSONL file.
# SUBSCRIBERS_FILE=./data/subscribers.jsonl

# Port for `npm run preview` (Node standalone server)
PORT=4322
